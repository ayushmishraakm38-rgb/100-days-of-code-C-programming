/*
Q57: Find the sum of array elements.

*/

#include <stdio.h>

int main(void) {
    int n;
    int array[100];
    long long sum = 0;

    scanf("%d", &n);

    if (n < 1 || n > 100) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &array[i]);
        sum += array[i];
    }

    printf("%lld\n", sum);

    return 0;
}
