/*
Q66: Insert an element in a sorted array at the appropriate position.

*/

#include <stdio.h>

int main(void) {
    int n;
    int array[101];
    int value;
    int position;

    scanf("%d", &n);

    if (n < 1 || n >= 101) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &array[i]);
    }

    scanf("%d", &value);

    /* Find where the new value belongs in ascending order. */
    position = n;
    while (position > 0 && array[position - 1] > value) {
        array[position] = array[position - 1];
        position--;
    }

    array[position] = value;
    n++;

    for (int i = 0; i < n; i++) {
        if (i > 0) {
            printf(" ");
        }
        printf("%d", array[i]);
    }

    printf("\n");

    return 0;
}
