/*
Q65: Search in a sorted array using binary search.

*/

#include <stdio.h>

int main(void) {
    int n;
    int array[100];
    int target;
    int left = 0, right, index = -1;

    scanf("%d", &n);

    if (n < 1 || n > 100) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &array[i]);
    }

    scanf("%d", &target);

    right = n - 1;

    while (left <= right) {
        int middle = left + (right - left) / 2;

        if (array[middle] == target) {
            index = middle;
            break;
        } else if (array[middle] < target) {
            left = middle + 1;
        } else {
            right = middle - 1;
        }
    }

    if (index != -1) {
        printf("Found at index %d\n", index);
    } else {
        printf("-1\n");
    }

    return 0;
}
