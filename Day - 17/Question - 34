/*
Q34: Write a program to check if a number is prime.

*/

#include <stdio.h>

int main(void) {
    int number;
    int isPrime = 1;

    scanf("%d", &number);

    if (number < 2) {
        isPrime = 0;
    } else {
        for (int i = 2; i <= number / i; i++) {
            if (number % i == 0) {
                isPrime = 0;
                break;
            }
        }
    }

    if (isPrime) {
        printf("Prime\n");
    } else {
        printf("Not prime\n");
    }

    return 0;
}
