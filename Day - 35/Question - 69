/*
Q69: Find the second largest distinct element in an array.

*/

#include <stdio.h>

int main(void) {
    int n;
    int array[100];

    scanf("%d", &n);

    if (n < 2 || n > 100) {
        printf("No second largest element\n");
        return 0;
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &array[i]);
    }

    int largest = array[0];
    int secondLargest = 0;
    int hasSecondLargest = 0;

    for (int i = 1; i < n; i++) {
        if (array[i] > largest) {
            secondLargest = largest;
            largest = array[i];
            hasSecondLargest = 1;
        } else if (array[i] < largest &&
                   (!hasSecondLargest || array[i] > secondLargest)) {
            secondLargest = array[i];
            hasSecondLargest = 1;
        }
    }

    if (hasSecondLargest) {
        printf("%d\n", secondLargest);
    } else {
        printf("No second largest element\n");
    }

    return 0;
}
