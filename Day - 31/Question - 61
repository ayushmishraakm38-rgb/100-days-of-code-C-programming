/*
Q61: Search for an element in an array using linear search.

*/

#include <stdio.h>

int main(void) {
    int n;
    int array[100];
    int target;
    int index = -1;

    scanf("%d", &n);

    if (n < 1 || n > 100) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &array[i]);
    }

    scanf("%d", &target);

    for (int i = 0; i < n; i++) {
        if (array[i] == target) {
            index = i;
            break;
        }
    }

    if (index != -1) {
        printf("Found at index %d\n", index);
    } else {
        printf("-1\n");
    }

    return 0;
}
