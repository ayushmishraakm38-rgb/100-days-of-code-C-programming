/*
Q63: Merge two arrays.

*/

#include <stdio.h>

int main(void) {
    int firstSize, secondSize;
    int first[100], second[100];

    scanf("%d", &firstSize);

    if (firstSize < 1 || firstSize > 100) {
        return 0;
    }

    for (int i = 0; i < firstSize; i++) {
        scanf("%d", &first[i]);
    }

    scanf("%d", &secondSize);

    if (secondSize < 1 || secondSize > 100) {
        return 0;
    }

    for (int i = 0; i < secondSize; i++) {
        scanf("%d", &second[i]);
    }

    for (int i = 0; i < firstSize; i++) {
        printf("%d ", first[i]);
    }

    for (int i = 0; i < secondSize; i++) {
        if (i > 0) {
            printf(" ");
        }
        printf("%d", second[i]);
    }

    printf("\n");

    return 0;
}
