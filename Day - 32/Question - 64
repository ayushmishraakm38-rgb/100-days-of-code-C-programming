/*
Q64: Find the digit that occurs the most times in an integer number.
If multiple digits occur the same maximum number of times, this program
prints the smallest such digit.

*/

#include <stdio.h>

int main(void) {
    long long number;
    int frequency[10] = {0};
    int mostFrequent = 0;

    scanf("%lld", &number);

    if (number < 0) {
        number = -number;
    }

    if (number == 0) {
        frequency[0] = 1;
    }

    while (number > 0) {
        int digit = number % 10;
        frequency[digit]++;
        number /= 10;
    }

    for (int digit = 1; digit <= 9; digit++) {
        if (frequency[digit] > frequency[mostFrequent]) {
            mostFrequent = digit;
        }
    }

    printf("%d\n", mostFrequent);

    return 0;
}
