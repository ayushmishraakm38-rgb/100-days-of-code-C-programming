/*
Q9: Write a program to calculate simple and compound interest for given
principal, rate, and time.

Assume interest is compounded annually.

*/


#include <stdio.h>
#include <math.h>

int main(void) {
    double principal, rate, time;
    double simpleInterest, compoundInterest;

    scanf("%lf %lf %lf", &principal, &rate, &time);

    simpleInterest = (principal * rate * time) / 100.0;
    compoundInterest = principal * pow(1.0 + rate / 100.0, time) - principal;

    printf("Simple Interest=%.0f, Compound Interest=%.2f\n",
           simpleInterest, compoundInterest);

    return 0;
}
