/*
Q13: Write a program to input a year and check whether it is a leap year
or not using conditional statements.

A year is a leap year if it is divisible by 400, or if it is divisible by 4
but not by 100.

*/

#include <stdio.h>

int main(void) {
    int year;

    scanf("%d", &year);

    if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0)) {
        printf("Leap year\n");
    } else {
        printf("Not a leap year\n");
    }

    return 0;
}
