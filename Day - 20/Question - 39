/*
Q39: Write a program to find the product of the odd digits of a number.
If there are no odd digits, assume the product is 1.

*/

#include <stdio.h>

int main(void) {
    long long number;
    long long product = 1;

    scanf("%lld", &number);

    if (number < 0) {
        number = -number;
    }

    while (number > 0) {
        int digit = number % 10;

        if (digit % 2 != 0) {
            product *= digit;
        }

        number /= 10;
    }

    printf("%lld\n", product);

    return 0;
}
