/*
Q42: Write a program to check if a number is a perfect number.

A perfect number is equal to the sum of its positive factors excluding
itself.

*/

#include <stdio.h>

int main(void) {
    int number;
    int sum = 0;

    scanf("%d", &number);

    for (int i = 1; i <= number / 2; i++) {
        if (number % i == 0) {
            sum += i;
        }
    }

    if (number > 0 && sum == number) {
        printf("Perfect number\n");
    } else {
        printf("Not perfect number\n");
    }

    return 0;
}
