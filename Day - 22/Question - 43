/*
Q43: Write a program to check if a number is a strong number.

A strong number is equal to the sum of the factorials of its digits.

*/

#include <stdio.h>

int main(void) {
    int number, original;
    int sum = 0;

    scanf("%d", &number);
    original = number;

    if (number < 0) {
        printf("Not strong number\n");
        return 0;
    }

    do {
        int digit = number % 10;
        int factorial = 1;

        for (int i = 1; i <= digit; i++) {
            factorial *= i;
        }

        sum += factorial;
        number /= 10;
    } while (number > 0);

    if (sum == original) {
        printf("Strong number\n");
    } else {
        printf("Not strong number\n");
    }

    return 0;
}
