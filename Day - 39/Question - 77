/*
Q77: Check if the elements on the main diagonal of a matrix are distinct.
*/

#include <stdio.h>

int main(void) {
    int rows, columns;
    int matrix[100][100];
    int allDistinct = 1;

    scanf("%d %d", &rows, &columns);

    if (rows < 1 || rows > 100 || columns < 1 || columns > 100) {
        return 0;
    }

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < columns; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    int diagonalLength = rows < columns ? rows : columns;

    for (int i = 0; i < diagonalLength && allDistinct; i++) {
        for (int j = i + 1; j < diagonalLength; j++) {
            if (matrix[i][i] == matrix[j][j]) {
                allDistinct = 0;
                break;
            }
        }
    }

    printf("%s\n", allDistinct ? "True" : "False");

    return 0;
}
