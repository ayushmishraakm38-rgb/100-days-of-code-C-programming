/*
Q78: Find the sum of the main diagonal elements of a square matrix.

*/

#include <stdio.h>

int main(void) {
    int rows, columns;
    long long sum = 0;

    scanf("%d %d", &rows, &columns);

    if (rows < 1 || rows > 100 || columns < 1 || columns > 100 ||
        rows != columns) {
        return 0;
    }

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < columns; j++) {
            int value;
            scanf("%d", &value);

            if (i == j) {
                sum += value;
            }
        }
    }

    printf("%lld\n", sum);

    return 0;
}
