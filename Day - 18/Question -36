/*
Q36: Write a program to find the HCF (GCD) of two numbers.

*/

#include <stdio.h>

int main(void) {
    int first, second;

    scanf("%d %d", &first, &second);

    // Convert negative inputs to positive values.
    if (first < 0) {
        first = -first;
    }
    if (second < 0) {
        second = -second;
    }

    while (second != 0) {
        int remainder = first % second;
        first = second;
        second = remainder;
    }

    printf("%d\n", first);

    return 0;
}
