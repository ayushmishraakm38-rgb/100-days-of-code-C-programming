/*
Q35: Write a program to print all factors of a given number.

*/

#include <stdio.h>

int main(void) {
    int number;
    int firstFactor = 1;

    scanf("%d", &number);

    if (number <= 0) {
        printf("Enter a positive integer\n");
        return 0;
    }

    for (int i = 1; i <= number; i++) {
        if (number % i == 0) {
            if (!firstFactor) {
                printf(" ");
            }

            printf("%d", i);
            firstFactor = 0;
        }
    }

    printf("\n");

    return 0;
}
