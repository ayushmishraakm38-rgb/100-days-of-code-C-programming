/*
Q23: Write a program to calculate the library fine based on the number of
days late:

First 5 days: ₹2 per day
Next 5 days: ₹4 per day
Next 20 days: ₹6 per day
More than 30 days: Membership Cancelled

*/

#include <stdio.h>

int main(void) {
    int lateDays;
    int fine;

    scanf("%d", &lateDays);

    if (lateDays < 0) {
        printf("Invalid number of days\n");
    } else if (lateDays > 30) {
        printf("Membership Cancelled\n");
    } else if (lateDays <= 5) {
        fine = lateDays * 2;
        printf("Fine \u20B9%d\n", fine);
    } else if (lateDays <= 10) {
        fine = (5 * 2) + (lateDays - 5) * 4;
        printf("Fine \u20B9%d\n", fine);
    } else {
        fine = (5 * 2) + (5 * 4) + (lateDays - 10) * 6;
        printf("Fine \u20B9%d\n", fine);
    }

    return 0;
}
