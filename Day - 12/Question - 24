/*
Q24: Write a program to calculate the electricity bill based on units
consumed using these rates:

First 100 units: ₹5 per unit
Next 100 units: ₹7 per unit
Next 100 units: ₹10 per unit
Units above 300: ₹12 per unit


*/

#include <stdio.h>

int main(void) {
    int units;
    int bill;

    scanf("%d", &units);

    if (units < 0) {
        printf("Invalid units\n");
    } else if (units <= 100) {
        bill = units * 5;
        printf("Bill: \u20B9%d\n", bill);
    } else if (units <= 200) {
        bill = (100 * 5) + (units - 100) * 7;
        printf("Bill: \u20B9%d\n", bill);
    } else if (units <= 300) {
        bill = (100 * 5) + (100 * 7) + (units - 200) * 10;
        printf("Bill: \u20B9%d\n", bill);
    } else {
        bill = (100 * 5) + (100 * 7) + (100 * 10) + (units - 300) * 12;
        printf("Bill: \u20B9%d\n", bill);
    }

    return 0;
}
