/*
Q80: Multiply two matrices. The number of columns in the first matrix must equal the number of rows
in the second matrix.
*/

#include <stdio.h>

int main(void) {
    int rows1, columns1, rows2, columns2;
    int first[100][100], second[100][100];
    long long product[100][100] = {0};

    scanf("%d %d", &rows1, &columns1);

    if (rows1 < 1 || rows1 > 100 || columns1 < 1 || columns1 > 100) {
        return 0;
    }

    for (int i = 0; i < rows1; i++) {
        for (int j = 0; j < columns1; j++) {
            scanf("%d", &first[i][j]);
        }
    }

    scanf("%d %d", &rows2, &columns2);

    if (rows2 < 1 || rows2 > 100 || columns2 < 1 || columns2 > 100) {
        return 0;
    }

    for (int i = 0; i < rows2; i++) {
        for (int j = 0; j < columns2; j++) {
            scanf("%d", &second[i][j]);
        }
    }

    if (columns1 != rows2) {
        printf("Matrix multiplication is not possible\n");
        return 0;
    }

    for (int i = 0; i < rows1; i++) {
        for (int j = 0; j < columns2; j++) {
            for (int k = 0; k < columns1; k++) {
                product[i][j] += (long long)first[i][k] * second[k][j];
            }
        }
    }

    for (int i = 0; i < rows1; i++) {
        for (int j = 0; j < columns2; j++) {
            if (j > 0) {
                printf(" ");
            }
            printf("%lld", product[i][j]);
        }
        printf("\n");
    }

    return 0;
}
